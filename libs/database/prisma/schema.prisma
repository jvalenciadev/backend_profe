  tenant     Departamento? @relation(fields: [tenantId], references: [id])
  user       User?         @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Profe {
  id            String    @id @default(uuid()) @map("profe_id") @db.Uuid
  imagen        String    @map("profe_imagen")
  nombre        String    @map("profe_nombre")
  descripcion   String    @map("profe_descripcion")
  sobreNosotros String    @map("profe_sobre_nosotros")
  mision        String    @map("profe_mision")
  vision        String    @map("profe_vision")
  actividad     String    @map("profe_actividad")
  fechaCreacion DateTime  @map("profe_fecha_creacion") @db.Date
  correo        String?   @map("profe_correo")
  celular       String?   @map("profe_celular")
  telefono      String?   @map("profe_telefono")
  pagina        String?   @map("profe_pagina")
  facebook      String?   @map("profe_facebook")
  tiktok        String?   @map("profe_tiktok")
  youtube       String?   @map("profe_youtube")
  ubicacion     String    @map("profe_ubicacion")
  latitud       Decimal?  @map("profe_latitud") @db.Decimal(11, 8)
  longitud      Decimal?  @map("profe_longitud") @db.Decimal(11, 8)
  banner        String    @map("profe_banner")
  afiche        String    @map("profe_afiche")
  convocatoria  String    @map("profe_convocatoria")
  estado        Estado    @default(ACTIVO) @map("profe_estado")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedBy     String?   @map("deleted_by") @db.Uuid

  @@map("profe")
}

model Cargo {
  id                 String             @id @default(uuid()) @map("car_id") @db.Uuid
  nombre             String             @map("car_nombre")
  estado             Estado             @default(ACTIVO) @map("car_estado")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")
  createdBy          String?            @map("created_by") @db.Uuid
  updatedBy          String?            @map("updated_by") @db.Uuid
  deletedBy          String?            @map("deleted_by") @db.Uuid
  bancoProfesionales BancoProfesional[]

  @@map("cargo")
}

model BancoProfesional {
  id                    String    @id @default(uuid()) @map("bp_id") @db.Uuid
  ci                    BigInt    @map("bp_ci")
  nombre                String    @map("bp_nombre")
  fechaNac              DateTime  @map("bp_fecha_nacimiento") @db.Date
  licUniversitaria      String?   @map("bp_lic_universitaria")
  esMaestro             Boolean   @default(false) @map("bp_es_maestro")
  categoria             String?   @map("bp_categoria") // 5ta, 4ta, 3ra, merito
  postgrados            Json?     @map("bp_postgrados") // List of Diplomados, Especialidades, Maestria, Doctorado
  produccionIntelectual Json?     @map("bp_produccion_intelectual") // List of { titulo, año, etc }
  hojaDeVidaPdf         String?   @map("bp_hoja_vida_pdf")
  cargoId               String    @map("car_id") @db.Uuid
  estado                Estado    @default(ACTIVO) @map("bp_estado")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  deletedBy             String?   @map("deleted_by") @db.Uuid
  cargo                 Cargo     @relation(fields: [cargoId], references: [id], onDelete: Cascade)

  @@map("banco_professional")
}

model EvaluacionAdmins {
  id                 String    @id @default(uuid()) @map("eva_id") @db.Uuid
  userId             String    @map("model_id") @db.Uuid
  gestion            String    @map("eva_gestion")
  semestre           String?   @map("eva_semestre")
  periodo            String    @map("eva_periodo") // "GESTIÓN 2022"
  criterios          Json      @map("eva_criterios") // { asistencia: 10, rasgos: 10, etc }
  puntajeTotal       Int       @map("eva_puntaje_total")
  codigoVerificacion String    @unique @map("eva_codigo_verificacion")
  qrCode             String?   @map("eva_qr_code")
  estado             Estado    @default(ACTIVO) @map("eva_estado")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  deletedBy          String?   @map("deleted_by") @db.Uuid
  user               User      @relation("UserEvaluations", fields: [userId], references: [id], onDelete: Cascade)

  @@map("evaluacion_admins")
}

enum Estado {
  ACTIVO    @map("activo")
  INACTIVO  @map("inactivo")
  ELIMINADO @map("eliminado")
  VISTA     @map("vista")
}
