  createdBy          String?       @map("created_by") @db.Uuid
  updatedBy          String?       @map("updated_by") @db.Uuid
  deletedBy          String?       @map("deleted_by") @db.Uuid
  galerias           Galeria[]
  programasDos       ProgramaDos[]
  departamento       Departamento  @relation(fields: [departamentoId], references: [id])
  users              UserSede[]

  @@map("sede")
}

model TipoEvento {
  id        String    @id @default(uuid()) @map("et_id") @db.Uuid
  nombre    String    @map("et_nombre")
  estado    Estado    @default(activo) @map("et_estado")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  eventos   Evento[]

  @@map("tipo_evento")
}

model token_dispositivo {
  id_token     Int      @id @default(autoincrement())
  token        String?
  tipo_usuario String?
  created_at   DateTime @default(now())
  updated_at   DateTime
}

model unidad_educativa {
  id         String    @id @default(uuid()) @map("uni_edu_id") @db.Uuid
  codigo     BigInt    @map("uni_edu_codigo")
  nombre     String    @map("uni_edu_nombre")
  estado     Estado    @default(activo) @map("uni_edu_estado")
  distritoId String?   @map("dis_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  String?   @map("created_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid

  @@map("unidad_educativa")
}

model UserSede {
  userId String @map("user_id") @db.Uuid
  sedeId String @map("sede_id") @db.Uuid
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sedeId])
  @@map("user_has_sedes")
}

model Video {
  id        String    @id @default(uuid()) @map("video_id") @db.Uuid
  iframe    String    @map("video_iframe")
  tipo      String    @default("YOUTUBE") @map("video_tipo")
  tenantId  String?   @map("tenant_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  estado    Estado    @default(activo) @map("video_estado")

  @@map("video")
}

enum Estado {
  activo
  inactivo
  eliminado
  vista
  pendiente
  aprobado
  inhabilitado
  cancelado
  finalizado
}
