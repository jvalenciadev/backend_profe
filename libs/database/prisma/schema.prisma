generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String                      @id @default(uuid()) @db.Uuid
  imagen                          String?
  nombre                          String
  apellidos                       String
  genero                          String?                     @default("No prefiero decirlo")
  licenciatura                    String?
  direccion                       String?
  curriculum                      String?
  fechaNacimiento                 String?                     @map("fecha_nacimiento")
  estadoCivil                     String?                     @map("estado_civil")
  facebook                        String?
  tiktok                          String?
  cargoStr                        String?                     @map("cargo")
  celular                         String?
  correo                          String                      @unique
  username                        String                      @unique
  password                        String
  rememberToken                   String?                     @map("remember_token")
  estado                          Estado                      @default(activo)
  resetPasswordToken              String?                     @map("reset_password_token")
  resetPasswordExpires            DateTime?                   @map("reset_password_expires")
  requiresPasswordChange          Boolean?                    @default(false) @map("requires_password_change")
  tenantId                        String?                     @map("tenant_id") @db.Uuid
  personaId                       String?                     @unique @map("per_id") @db.Uuid
  tokenDispositivo                String?                     @map("token_dispositivo")
  deviceTokens                    token_dispositivo[]
  createdAt                       DateTime                    @default(now()) @map("created_at")
  updatedAt                       DateTime                    @updatedAt @map("updated_at")
  deletedAt                       DateTime?                   @map("deleted_at")
  createdBy                       String?                     @map("created_by") @db.Uuid
  updatedBy                       String?                     @map("updated_by") @db.Uuid
  deletedBy                       String?                     @map("deleted_by") @db.Uuid
  sedeIds                         String?                     @map("sede_ids")
  proIds                          String?                     @map("pro_ids")
  // ── Identificación ───────────────────────────────────────────────────────
  ci                              BigInt?                     @map("per_ci")
  complemento                     String?                     @map("per_complemento")
  // ── Banco Profesional ────────────────────────────────────────────────────
  esMaestro                       Boolean                     @default(false) @map("bp_es_maestro")
  licUniversitaria                String?                     @map("bp_lic_universitaria")
  licMescp                        String?                     @map("bp_lic_mescp")
  tieneProduccion                 Boolean                     @default(false) @map("bp_tiene_produccion")
  hojaDeVidaPdf                   String?                     @map("bp_hoja_vida_pdf")
  rda                             BigInt?                     @unique @map("per_rda")
  rdaPdf                          String?                     @map("bp_rda_pdf")
  categoriaId                     String?                     @map("cat_id") @db.Uuid
  cargoPostulacionId              String?                     @map("car_id_postulacion") @db.Uuid
  resumenProfesional              String?                     @map("bp_resumen_profesional")
  habilidades                     String?                     @map("bp_habilidades")
  idiomas                         String?                     @map("bp_idiomas")
  experienciaLaboral              String?                     @map("bp_experiencia_laboral")
  linkedinUrl                     String?                     @map("bp_linkedin_url")
  cargoPostulacion                Cargo?                      @relation(fields: [cargoPostulacionId], references: [id])
  categoria                       MapCategoria?               @relation(fields: [categoriaId], references: [id])
  tenant                          Departamento?               @relation("UserTenant", fields: [tenantId], references: [id])
  auditLogs                       AuditLog[]
  bp_posgrado                     bp_posgrado[]
  bp_produccion_intelectual       bp_produccion_intelectual[]
  evaluaciones                    EvaluacionAdmins[]
  roles                           UserRole[]
  programaDosFacilitadors         ProgramaDosFacilitador[]
  sedes                           UserSede[]
  // LMS Moodle Relations
  mod_foro_posts                  mod_foro_post[]
  mod_tarea_entregas              mod_entrega[]
  mod_cuestionario_intentos       mod_intento[]
  mod_asistencia_regs             mod_asistencia_reg[]
  mod_nota_actividades            mod_nota_actividad[]
  mod_nota_finales                mod_nota_final[]
  mod_insignias                   mod_insignia_user[]
  mod_notificaciones              mod_notificacion[]
  modulosMaestrosAsignados        ProgramaModulo[]
  inscripciones                   ProgramaInscripcion[]       @relation("InscripcionesUser")
  mod_nota_actividads_facilitadas mod_nota_actividad[]        @relation("FacilitadorNotas")
  mod_campos_extra_regs           mod_campo_extra_respuesta[]

  // --- Correspondencia ---
  cor_participaciones        CorParticipante[]
  cor_seguimientos           CorSeguimiento[]
  cor_seguimientos_como_dest CorSeguimiento[]  @relation("CorSeguimientoDestinatario")

  @@index([ci])
  @@index([ci, complemento])
  @@map("admins")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  action     String
  resource   String
  resourceId String?
  userId     String?  @db.Uuid
  details    Json?
  ip         String?
  userAgent  String?
  timestamp  DateTime @default(now())
  tenantId   String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model verificacion_codigo {
  id        Int      @id @default(autoincrement())
  correo    String
  codigo    String
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([correo])
  @@map("verificacion_codigos")
}

model Blog {
  id          String        @id @default(uuid()) @map("blog_id") @db.Uuid
  titulo      String        @map("blog_titulo")
  descripcion String?       @map("blog_descripcion")
  fecha       DateTime?     @map("blog_fecha") @db.Date
  estado      Estado        @default(activo) @map("blog_estado")
  tenantId    String?       @map("tenant_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  imagenes    Json?         @map("blog_imagenes")
  tipo        String?       @map("blog_tipo")
  createdBy   String?       @map("created_by") @db.Uuid
  deletedAt   DateTime?     @map("deleted_at")
  deletedBy   String?       @map("deleted_by") @db.Uuid
  updatedBy   String?       @map("updated_by") @db.Uuid
  tenant      Departamento? @relation(fields: [tenantId], references: [id])

  @@map("blog")
}

model bp_posgrado {
  bpg_id           String           @id @default(uuid()) @db.Uuid
  btp_id           String           @db.Uuid
  bpg_titulo       String
  bpg_fecha        DateTime         @db.Date
  bpg_imagen       String?
  bpg_estado       Estado           @default(activo)
  created_at       DateTime         @default(now())
  updated_at       DateTime
  deleted_at       DateTime?
  created_by       String?          @db.Uuid
  updated_by       String?          @db.Uuid
  deleted_by       String?          @db.Uuid
  user_id          String           @db.Uuid
  bp_tipo_posgrado bp_tipo_posgrado @relation(fields: [btp_id], references: [btp_id])
  admins           User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model bp_produccion_intelectual {
  bpi_id               String    @id @default(uuid()) @db.Uuid
  bpi_titulo           String
  bpi_anio_publicacion Int
  bpi_estado           Estado    @default(activo)
  created_at           DateTime  @default(now())
  updated_at           DateTime
  deleted_at           DateTime?
  created_by           String?   @db.Uuid
  updated_by           String?   @db.Uuid
  deleted_by           String?   @db.Uuid
  user_id              String    @db.Uuid
  admins               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model bp_tipo_posgrado {
  btp_id      String        @id @default(uuid()) @db.Uuid
  btp_nombre  String
  btp_estado  Estado        @default(activo)
  btp_orden   Int           @default(0)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  bp_posgrado bp_posgrado[]
}

model Cargo {
  id           String             @id @default(uuid()) @map("car_id") @db.Uuid
  nombre       String             @map("car_nombre")
  estado       Estado             @default(activo) @map("car_estado")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  deletedAt    DateTime?          @map("deleted_at")
  createdBy    String?            @map("created_by") @db.Uuid
  updatedBy    String?            @map("updated_by") @db.Uuid
  deletedBy    String?            @map("deleted_by") @db.Uuid
  admins       User[]
  evaluaciones EvaluacionAdmins[]

  @@map("cargo")
}

model Comunicado {
  id          String        @id @default(uuid()) @map("comun_id") @db.Uuid
  imagen      String        @map("comun_imagen")
  nombre      String        @map("comun_nombre")
  descripcion String        @map("comun_descripcion")
  importancia String        @default("normal") @map("comun_importancia")
  estado      Estado        @default(activo) @map("comun_estado")
  tenantId    String?       @map("tenant_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  tipo        String?       @map("comun_tipo")
  createdBy   String?       @map("created_by") @db.Uuid
  deletedAt   DateTime?     @map("deleted_at")
  deletedBy   String?       @map("deleted_by") @db.Uuid
  updatedBy   String?       @map("updated_by") @db.Uuid
  tenant      Departamento? @relation(fields: [tenantId], references: [id])

  @@map("comunicado")
}

model Departamento {
  id          String       @id @default(uuid()) @map("dep_id") @db.Uuid
  nombre      String       @map("dep_nombre")
  abreviacion String       @map("dep_abreviacion")
  estado      Estado       @default(activo) @map("dep_estado")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  createdBy   String?      @map("created_by") @db.Uuid
  updatedBy   String?      @map("updated_by") @db.Uuid
  deletedBy   String?      @map("deleted_by") @db.Uuid
  users       User[]       @relation("UserTenant")
  blogs       Blog[]
  comunicados Comunicado[]
  distritos   distrito[]
  eventos     Evento[]
  sedes       Sede[]

  @@map("departamento")
}

model distrito {
  id               String             @id @default(uuid()) @map("dis_id") @db.Uuid
  codigo           Int                @map("dis_codigo")
  nombre           String             @map("dis_nombre")
  estado           Estado             @default(activo) @map("dis_estado")
  departamentoId   String             @map("dep_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")
  createdBy        String?            @map("created_by") @db.Uuid
  updatedBy        String?            @map("updated_by") @db.Uuid
  deletedBy        String?            @map("deleted_by") @db.Uuid
  departamento     Departamento       @relation(fields: [departamentoId], references: [id])
  unidadEducativas unidad_educativa[]

  @@map("distrito")
}

model EvaluacionAdmins {
  id                 String              @id @default(uuid()) @map("eva_id") @db.Uuid
  puntajeTotal       Int                 @map("eva_puntaje_total")
  codigoVerificacion String              @map("eva_codigo_verificacion")
  qrCode             String?             @map("eva_qr_code")
  estado             Estado              @default(activo) @map("eva_estado")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  createdBy          String?             @map("created_by") @db.Uuid
  updatedBy          String?             @map("updated_by") @db.Uuid
  deletedBy          String?             @map("deleted_by") @db.Uuid
  periodoId          String              @map("evp_id") @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  tenantId           String?             @map("tenant_id") @db.Uuid
  cargoId            String?             @map("car_id_postulacion") @db.Uuid
  cargo              Cargo?              @relation(fields: [cargoId], references: [id])
  periodoEval        EvaluacionPeriodo   @relation(fields: [periodoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "evaluacion_admins_periodo_fkey")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "evaluacion_admins_user_fkey")
  puntajes           EvaluacionPuntaje[]

  @@unique([userId, periodoId], map: "evaluacion_admins_user_periodo_unique")
  @@map("evaluacion_admins")
}

model EvaluacionCriterio {
  id            String              @id @default(uuid()) @map("evc_id") @db.Uuid
  periodoId     String              @map("evp_id") @db.Uuid
  nombre        String              @map("evc_nombre")
  puntajeMaximo Int                 @map("evc_puntaje_maximo")
  orden         Int                 @default(0) @map("evc_orden")
  estado        Estado              @default(activo) @map("evc_estado")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  periodoEval   EvaluacionPeriodo   @relation(fields: [periodoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "evaluacion_criterio_periodo_fkey")
  puntajes      EvaluacionPuntaje[]

  @@map("evaluacion_criterio")
}

model EvaluacionPeriodo {
  id           String               @id @default(uuid()) @map("evp_id") @db.Uuid
  periodo      String               @map("evp_periodo")
  gestion      String               @map("evp_gestion")
  semestre     String               @map("evp_semestre")
  activo       Boolean              @default(true) @map("evp_activo")
  estado       Estado               @default(activo) @map("evp_estado")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  createdBy    String?              @map("created_by") @db.Uuid
  updatedBy    String?              @map("updated_by") @db.Uuid
  deletedBy    String?              @map("deleted_by") @db.Uuid
  evaluaciones EvaluacionAdmins[]
  criterios    EvaluacionCriterio[]

  @@map("evaluacion_periodo")
}

model EvaluacionPuntaje {
  id           String             @id @default(uuid()) @map("evpu_id") @db.Uuid
  evaluacionId String             @map("eva_id") @db.Uuid
  criterioId   String             @map("evc_id") @db.Uuid
  puntaje      Int                @map("evpu_puntaje")
  criterio     EvaluacionCriterio @relation(fields: [criterioId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "evaluacion_puntaje_crit_fkey")
  evaluacion   EvaluacionAdmins   @relation(fields: [evaluacionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "evaluacion_puntaje_eval_fkey")

  @@unique([evaluacionId, criterioId], map: "evaluacion_puntaje_eval_crit_unique")
  @@map("evaluacion_puntaje")
}

model Evento {
  id                 String               @id @default(uuid()) @map("eve_id") @db.Uuid
  nombre             String               @map("eve_nombre")
  codigo             String?              @map("eve_codigo")
  descripcion        String               @map("eve_descripcion") @db.Text
  banner             String               @map("eve_banner")
  afiche             String               @map("eve_afiche")
  modalidadIds       String               @map("pm_ids")
  fecha              DateTime             @map("eve_fecha") @db.Date
  inscripcionAbierta Boolean              @default(true) @map("eve_inscripcion")
  asistencia         Boolean?             @map("eve_asistencia")
  codigoAsistencia   String?              @map("eve_codigo_asistencia")
  lugar              String               @map("eve_lugar")
  urlVideo           String?              @map("eve_url_video") // YouTube URL o ID para eventos virtuales
  totalInscritos     Int                  @default(0) @map("eve_total_inscrito")
  estado             Estado               @default(activo) @map("eve_estado")
  tipoId             String               @map("et_id") @db.Uuid
  tenantId           String?              @map("tenant_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  deletedAt          DateTime?            @map("deleted_at")
  createdBy          String?              @map("created_by") @db.Uuid
  updatedBy          String?              @map("updated_by") @db.Uuid
  deletedBy          String?              @map("deleted_by") @db.Uuid
  tipo               TipoEvento           @relation(fields: [tipoId], references: [id])
  tenant             Departamento?        @relation(fields: [tenantId], references: [id])
  cuestionarios      EventoCuestionario[]
  eventoInscripcions EventoInscripcion[]
  camposExtras       EventoCampoExtra[]

  @@map("evento")
}

model EventoCuestionario {
  id                String                      @id @default(uuid()) @map("eve_cue_id") @db.Uuid
  titulo            String                      @map("eve_cue_titulo")
  descripcion       String                      @map("eve_cue_descripcion") @db.Text
  fechaInicio       DateTime                    @map("eve_cue_fecha_ini")
  fechaFin          DateTime                    @map("eve_cue_fecha_fin")
  tiempoMaximo      Int?                        @map("eve_cue_tiempo_max") // en minutos
  puntosMaximos     Int?                        @map("eve_cue_pts_max")
  puntajeMinimo     Int                         @default(0) @map("eve_cue_pts_min")
  cantidadPreguntas Int?                        @map("eve_cue_cantidad_preg") // Cuántas preguntas mostrar
  esAleatorio       Boolean                     @default(false) @map("eve_cue_es_aleatorio") // Mezclar preguntas
  limiteIntentos    Int?                        @map("eve_cue_limite_intentos") // null = sin límite de intentos
  urlVideo          String?                     @map("eve_cue_url_video") // ID o URL del video de YouTube a ver antes
  orden             Int                         @default(0) @map("eve_cue_orden")
  esObligatorio     Boolean                     @default(true) @map("eve_cue_es_obligatorio")
  esEvaluativo      Boolean                     @default(true) @map("eve_cue_es_evaluativo")
  estado            Estado                      @default(activo) @map("eve_cue_estado")
  eventoId          String                      @map("eve_id") @db.Uuid
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  createdBy         String?                     @map("created_by") @db.Uuid
  deletedAt         DateTime?                   @map("deleted_at")
  deletedBy         String?                     @map("deleted_by") @db.Uuid
  updatedBy         String?                     @map("updated_by") @db.Uuid
  evento            Evento                      @relation(fields: [eventoId], references: [id])
  preguntas         evento_pregunta[]
  intentos          EventoCuestionarioIntento[]

  @@map("evento_cuestionario")
}

model EventoInscripcion {
  id               String                      @id @default(uuid()) @map("eve_ins_id") @db.Uuid
  asistencia       Boolean                     @default(false) @map("eve_ins_asistencia")
  estado           Estado                      @default(activo) @map("eve_ins_estado")
  nroDeposito      String?                     @map("eve_nro_deposito")
  fechaDeposito    DateTime?                   @map("eve_fecha_deposito") @db.Date
  imagenDeposito   String?                     @map("eve_imagen_deposito")
  personaId        String                      @map("eve_per_id") @db.Uuid
  eventoId         String                      @map("eve_id") @db.Uuid
  departamentoId   String                      @map("dep_id") @db.Uuid
  modalidadId      String                      @map("pm_id") @db.Uuid
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  createdBy        String?                     @map("created_by") @db.Uuid
  deletedAt        DateTime?                   @map("deleted_at")
  deletedBy        String?                     @map("deleted_by") @db.Uuid
  updatedBy        String?                     @map("updated_by") @db.Uuid
  evento           Evento                      @relation(fields: [eventoId], references: [id])
  persona          EventoPersona               @relation(fields: [personaId], references: [id])
  respuestasExtras EventoCampoExtraRespuesta[]

  @@map("evento_inscripcion_v2")
}

model evento_opciones {
  id         String              @id @default(uuid()) @map("eve_opc_id") @db.Uuid
  texto      String              @map("eve_opc_texto")
  esCorrecta Boolean             @default(false) @map("eve_opc_es_correcta")
  estado     Estado              @default(activo) @map("eve_opc_estado")
  preguntaId String              @map("eve_pre_id") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  createdBy  String?             @map("created_by") @db.Uuid
  deletedAt  DateTime?           @map("deleted_at")
  deletedBy  String?             @map("deleted_by") @db.Uuid
  updatedBy  String?             @map("updated_by") @db.Uuid
  pregunta   evento_pregunta     @relation(fields: [preguntaId], references: [id])
  respuestas evento_respuestas[]

  @@map("evento_opciones")
}

model EventoPersona {
  id                         String                      @id @default(uuid()) @map("eve_per_id") @db.Uuid
  ci                         BigInt                      @map("eve_per_ci")
  complemento                String                      @map("eve_per_complemento")
  expedido                   String                      @map("eve_per_expedido")
  nombre1                    String                      @map("eve_per_nombre_1")
  nombre2                    String                      @map("eve_per_nombre_2")
  apellido1                  String                      @map("eve_per_apellido_1")
  apellido2                  String                      @map("eve_per_apellido_2")
  fechaNacimiento            DateTime                    @map("eve_per_fecha_nacimiento") @db.Date
  correo                     String                      @map("eve_per_correo")
  celular                    String                      @map("eve_per_celular")
  generoId                   BigInt                      @map("gen_id")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  createdBy                  String?                     @map("created_by") @db.Uuid
  deletedAt                  DateTime?                   @map("deleted_at")
  deletedBy                  String?                     @map("deleted_by") @db.Uuid
  updatedBy                  String?                     @map("updated_by") @db.Uuid
  inscripciones              EventoInscripcion[]
  eventoCuestionarioIntentos EventoCuestionarioIntento[]

  @@map("evento_personas")
}

model evento_pregunta {
  id             String              @id @default(uuid()) @map("eve_pre_id") @db.Uuid
  texto          String              @map("eve_pre_texto")
  tipo           String              @map("eve_pre_tipo") // MULTIPLE, SINGLE, TRUE_FALSE, TEXTO, ORDENAR, RELACIONAR
  puntos         Int                 @default(1) @map("eve_pre_puntos")
  obligatorio    Boolean             @default(true) @map("eve_pre_obligatorio")
  estado         Estado              @default(activo) @map("eve_pre_estado")
  cuestionarioId String              @map("eve_cue_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  createdBy      String?             @map("created_by") @db.Uuid
  deletedAt      DateTime?           @map("deleted_at")
  deletedBy      String?             @map("deleted_by") @db.Uuid
  updatedBy      String?             @map("updated_by") @db.Uuid
  cuestionario   EventoCuestionario  @relation(fields: [cuestionarioId], references: [id])
  opciones       evento_opciones[]
  respuestas     evento_respuestas[]

  @@map("evento_pregunta")
}

model evento_respuestas {
  id             BigInt           @id @default(autoincrement()) @map("eve_res_id")
  texto          String?          @map("eve_res_texto")
  esCorrecta     Boolean          @default(false) @map("eve_res_es_correcta")
  puntos         Int              @default(0) @map("eve_res_puntos")
  cuestionarioId String?          @map("eve_cue_id") @db.Uuid
  preguntaId     String           @map("eve_pre_id") @db.Uuid
