  sedeId              String    @map("sede_id") @db.Uuid
  // FK → programa_inscripcion_estado
  estadoInscripcionId String    @map("pie_id") @db.Uuid
  // FK → User (admins) — el participante inscrito
  personaId           String    @map("per_id") @db.Uuid
  tenantId            String?   @map("tenant_id") @db.Uuid
