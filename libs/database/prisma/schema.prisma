// =============================================================
// 🎓 LMS MOODLE SYSTEM — Prefijo: mod_
// Sistema académico completo tipo Moodle, integrado a ProgramaDos
// =============================================================

// ---------------------------------------------------------
// 1. CONFIGURACIÓN DE CALIFICACIONES POR TIPO DE PROGRAMA
//    Ej: Diplomado → 80% Producto Académico + 20% Producto Final
// ---------------------------------------------------------

/// Define las categorías de calificación para cada tipo de programa.
/// Ej: ProgramaTipo "Diplomado" → [Producto Académico 80%, Producto Final 20%]
model mod_tipo_calificacion_config {
  id             String   @id @default(uuid()) @db.Uuid
  tipoProgramaId String   @map("pro_tip_id") @db.Uuid
  nombre         String   @map("mod_tcc_nombre") // "Producto Académico", "Producto Final"
  peso           Int      @map("mod_tcc_peso") // 80, 20
  esEvalFinal    Boolean  @default(false) @map("mod_tcc_es_eval_final") // true = el examen final
  orden          Int      @default(0) @map("mod_tcc_orden")
  estado         Estado   @default(activo) @map("mod_tcc_estado")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tipoPrograma ProgramaTipo @relation(fields: [tipoProgramaId], references: [id])

  // Una vez configurado, cada módulo instancia estas categorías
  mod_categorias mod_categoria_calificacion[]

  @@map("mod_tipo_calificacion_config")
}

/// Instancia real de una categoría en un módulo concreto.
/// Permite que cada módulo tenga su propia configuración heredada del tipo.
model mod_categoria_calificacion {
  id              String   @id @default(uuid()) @db.Uuid
  moduloId        String?  @map("pm_id") @db.Uuid
  moduloMaestroId String?  @map("pm_id_maestro") @db.Uuid
  configId        String   @map("mod_tcc_id") @db.Uuid
  estado          Estado   @default(activo) @map("mod_cc_estado")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  turnoId         String?  @map("pdt_id") @db.Uuid

  modulo        ProgramaModuloDos?           @relation(fields: [moduloId], references: [id])
  moduloMaestro ProgramaModulo?              @relation(fields: [moduloMaestroId], references: [id])
  config        mod_tipo_calificacion_config @relation(fields: [configId], references: [id])

  // Actividades que pertenecen a esta categoría
  actividades mod_actividad[]

  @@map("mod_categoria_calificacion")
}

// ---------------------------------------------------------
// 2. UNIDADES TEMÁTICAS (Semanas del módulo)
//    Calculadas desde fechaInicio + pd_semana de ProgramaDuracion
// ---------------------------------------------------------

/// Una unidad temática representa una semana de clase dentro de un módulo.
/// Se generan automáticamente al calcular: fechaInicio + N semanas de duración.
model mod_unidad_tematica {
  id              String   @id @default(uuid()) @db.Uuid
  moduloId        String?  @map("pm_id") @db.Uuid
  moduloMaestroId String?  @map("pm_id_maestro") @db.Uuid
  titulo          String   @map("mod_ut_titulo") // "Semana 1: Introducción"
  descripcion     String?  @map("mod_ut_descripcion") @db.Text
  semana          Int      @map("mod_ut_semana") // Número de semana: 1, 2, 3...
  fechaInicio     DateTime @map("mod_ut_fecha_inicio") @db.Date
  fechaFin        DateTime @map("mod_ut_fecha_fin") @db.Date
  orden           Int      @default(0) @map("mod_ut_orden")
  estado          Estado   @default(activo) @map("mod_ut_estado")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  turnoId         String?  @map("pdt_id") @db.Uuid

  modulo        ProgramaModuloDos? @relation(fields: [moduloId], references: [id])
  moduloMaestro ProgramaModulo?    @relation(fields: [moduloMaestroId], references: [id])

  // Actividades de la semana
  actividades mod_actividad[]
  // Recursos de apoyo de la semana
  recursos    mod_recurso[]

  @@map("mod_unidad_tematica")
}

// ---------------------------------------------------------
// 3. ACTIVIDADES (el corazón del LMS)
//    Una actividad puede ser: FORO, TAREA, CUESTIONARIO,
//    FORMULARIO (sin nota), RECURSO (solo lectura)
// ---------------------------------------------------------

enum ModTipoActividad {
  FORO
  TAREA
  CUESTIONARIO
  FORMULARIO // Como cuestionario pero SIN valor en registro de calificaciones
  RECURSO // Solo material de apoyo
  ASISTENCIA // Control de asistencia como actividad calificada
}

/// Actividad académica dentro de una unidad temática.
/// Cada actividad pertenece a una categoría de calificación (o es FORMULARIO/RECURSO sin nota).
model mod_actividad {
  id            String           @id @default(uuid()) @db.Uuid
  unidadId      String           @map("mod_ut_id") @db.Uuid
  categoriaId   String?          @map("mod_cc_id") @db.Uuid // null si es FORMULARIO o RECURSO
  tipo          ModTipoActividad @map("mod_act_tipo")
  titulo        String           @map("mod_act_titulo")
  instrucciones String?          @map("mod_act_instrucciones") @db.Text
  puntajeMax    Int              @default(100) @map("mod_act_puntaje_max")
  esCalificable Boolean          @default(true) @map("mod_act_es_calificable")
  // false = FORMULARIO (el alumno puede ver su nota pero NO entra en el registro)
  fechaInicio   DateTime         @map("mod_act_fecha_inicio")
  fechaFin      DateTime         @map("mod_act_fecha_fin")
  orden         Int              @default(0) @map("mod_act_orden")
  estado        Estado           @default(activo) @map("mod_act_estado")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  unidad    mod_unidad_tematica         @relation(fields: [unidadId], references: [id])
  categoria mod_categoria_calificacion? @relation(fields: [categoriaId], references: [id])

  // Tipos específicos (relación 1:1 opcional)
  foro         mod_foro?
  tarea        mod_tarea?
  cuestionario mod_cuestionario?
  asistencia   mod_asistencia?

  // Notas individuales de alumnos para esta actividad
  notas mod_nota_actividad[]

  @@map("mod_actividad")
}

// ---------------------------------------------------------
// 4. FOROS (con hilos y respuestas)
// ---------------------------------------------------------

model mod_foro {
  id            String          @id @default(uuid()) @db.Uuid
  actividadId   String          @unique @map("mod_act_id") @db.Uuid
  permitirFiles Boolean         @default(true) @map("mod_foro_permit_files")
  maxArchivos   Int             @default(3) @map("mod_foro_max_arch")
  actividad     mod_actividad   @relation(fields: [actividadId], references: [id])
  posts         mod_foro_post[]

  @@map("mod_foro")
}

/// Publicación en el foro. Soporta threading (padreId para respuestas).
model mod_foro_post {
  id         String   @id @default(uuid()) @db.Uuid
  foroId     String   @map("mod_foro_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  padreId    String?  @map("mod_post_padre_id") @db.Uuid // null = post raíz
  mensaje    String   @map("mod_post_mensaje") @db.Text
  archivoUrl String?  @map("mod_post_archivo")
  editado    Boolean  @default(false) @map("mod_post_editado")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  foro       mod_foro        @relation(fields: [foroId], references: [id])
  user       User            @relation(fields: [userId], references: [id])
  padre      mod_foro_post?  @relation("ForoHilos", fields: [padreId], references: [id])
  respuestas mod_foro_post[] @relation("ForoHilos")

  @@map("mod_foro_post")
}

// ---------------------------------------------------------
// 5. TAREAS (con entregas de archivos y/o texto)
// ---------------------------------------------------------

model mod_tarea {
  id          String        @id @default(uuid()) @db.Uuid
  actividadId String        @unique @map("mod_act_id") @db.Uuid
  allowFiles  Boolean       @default(true) @map("mod_tar_allow_files")
  allowText   Boolean       @default(true) @map("mod_tar_allow_text")
  maxArchivos Int           @default(1) @map("mod_tar_max_arch")
  tiposArch   String        @default("pdf,doc,docx,jpg,png") @map("mod_tar_tipos_arch")
  actividad   mod_actividad @relation(fields: [actividadId], references: [id])
  entregas    mod_entrega[]

  @@map("mod_tarea")
}

/// Entrega de un alumno para una tarea específica.
model mod_entrega {
  id                String   @id @default(uuid()) @db.Uuid
  tareaId           String   @map("mod_tar_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  archivoUrl        String?  @map("mod_ent_archivo")
  texto             String?  @map("mod_ent_texto") @db.Text
  calificada        Boolean  @default(false) @map("mod_ent_calificada")
  nota              Float?   @map("mod_ent_nota")
  retroalimentacion String?  @map("mod_ent_retroalim") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tarea mod_tarea @relation(fields: [tareaId], references: [id])
  user  User      @relation(fields: [userId], references: [id])

  @@map("mod_entrega")
}

// ---------------------------------------------------------
// 6. CUESTIONARIOS y FORMULARIOS
//    - Cuestionario: entra en el registro de calificaciones
//    - Formulario:   el alumno ve sus resultados pero NO cuenta para la nota
// ---------------------------------------------------------

model mod_cuestionario {
  id             String         @id @default(uuid()) @db.Uuid
  actividadId    String         @unique @map("mod_act_id") @db.Uuid
  duracion       Int            @default(60) @map("mod_cue_duracion") // minutos
  maxIntentos    Int            @default(1) @map("mod_cue_max_intentos")
  aleatorizar    Boolean        @default(false) @map("mod_cue_random")
  randomCount    Int?           @map("mod_cue_random_count") // Número de preguntas aleatorias a mostrar
  mostrarNota    Boolean        @default(true) @map("mod_cue_mostrar_nota")
  retroInmediata Boolean        @default(false) @map("mod_cue_retro_inmediata")
  soloMobile     Boolean        @default(false) @map("mod_cue_solo_mobile") // Obliga a usar celular
  bloquearCopia  Boolean        @default(false) @map("mod_cue_bloquear_copia") // Bloquea selección/copiado
  actividad      mod_actividad  @relation(fields: [actividadId], references: [id])
  preguntas      mod_pregunta[]
  intentos       mod_intento[]

  @@map("mod_cuestionario")
}

enum ModTipoPregunta {
  MULTIPLE // Una sola respuesta correcta
  MULTIPLE_M // Varias respuestas correctas
  VF // Verdadero / Falso
  TEXTO // Respuesta libre (calificada manualmente)
  ORDENAR // Ordenar elementos
}

model mod_pregunta {
  id             String          @id @default(uuid()) @db.Uuid
  cuestionarioId String          @map("mod_cue_id") @db.Uuid
  texto          String          @map("mod_pre_texto") @db.Text
  tipo           ModTipoPregunta @map("mod_pre_tipo")
  puntaje        Float           @default(1) @map("mod_pre_puntaje")
  imagen         String?         @map("mod_pre_imagen")
  orden          Int             @default(0) @map("mod_pre_orden")
  estado         Estado          @default(activo) @map("mod_pre_estado")

  cuestionario mod_cuestionario @relation(fields: [cuestionarioId], references: [id])
  opciones     mod_opcion[]

  @@map("mod_pregunta")
}

model mod_opcion {
  id         String  @id @default(uuid()) @db.Uuid
  preguntaId String  @map("mod_pre_id") @db.Uuid
  texto      String  @map("mod_opc_texto")
  esCorrecta Boolean @default(false) @map("mod_opc_correcta")
  orden      Int     @default(0) @map("mod_opc_orden")

  pregunta mod_pregunta @relation(fields: [preguntaId], references: [id])

  @@map("mod_opcion")
}

/// Intento de un alumno en un cuestionario/formulario.
model mod_intento {
  id             String    @id @default(uuid()) @db.Uuid
  cuestionarioId String    @map("mod_cue_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  puntajeTotal   Float?    @map("mod_int_puntaje")
  numero         Int       @default(1) @map("mod_int_numero") // Nro de intento
  iniciadoEn     DateTime  @default(now()) @map("mod_int_inicio")
  finalizadoEn   DateTime? @map("mod_int_fin")
  estado         String    @default("en_progreso") @map("mod_int_estado") // en_progreso, finalizado
  motivoBloqueo  String?   @map("mod_int_motivo_bloqueo")

  cuestionario mod_cuestionario @relation(fields: [cuestionarioId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  respuestas   mod_respuesta[]

  @@map("mod_intento")
}

/// Respuesta de un alumno a una pregunta dentro de un intento.
model mod_respuesta {
  id         String   @id @default(uuid()) @db.Uuid
  intentoId  String   @map("mod_int_id") @db.Uuid
  preguntaId String   @map("mod_pre_id") @db.Uuid
  opcionId   String?  @map("mod_opc_id") @db.Uuid // null si es texto libre
  textoLibre String?  @map("mod_res_texto") @db.Text
  esCorrecta Boolean? @map("mod_res_correcta")
  puntaje    Float?   @map("mod_res_puntaje")

  intento mod_intento @relation(fields: [intentoId], references: [id])

  @@map("mod_respuesta")
}

// ---------------------------------------------------------
// 7. RECURSOS DE APOYO (PDF, VIDEO, IMAGEN, LINK)
//    Pueden ir en una unidad temática o en una actividad
// ---------------------------------------------------------

enum ModTipoRecurso {
  PDF
  VIDEO
  YOUTUBE
  IMAGEN
  LINK
  PRESENTACION
  TITULO
}

model mod_recurso {
  id          String         @id @default(uuid()) @db.Uuid
  unidadId    String         @map("mod_ut_id") @db.Uuid
  titulo      String         @map("mod_rec_titulo")
  tipo        ModTipoRecurso @map("mod_rec_tipo")
  url         String?        @map("mod_rec_url") // Ahora es opcional para tipos como "TÍTULO"
  externo     Boolean        @default(false) @map("mod_rec_externo")
  descripcion String?        @map("mod_rec_desc")
  orden       Int            @default(0) @map("mod_rec_orden")
  estado      Estado         @default(activo) @map("mod_rec_estado")
  createdAt   DateTime       @default(now()) @map("created_at")

  unidad mod_unidad_tematica @relation(fields: [unidadId], references: [id])

  @@map("mod_recurso")
}

// ---------------------------------------------------------
// 8. ASISTENCIA DIARIA
// ---------------------------------------------------------

model mod_asistencia {
  id              String   @id @default(uuid()) @db.Uuid
  moduloId        String?  @map("pm_id") @db.Uuid
  moduloMaestroId String?  @map("pm_id_maestro") @db.Uuid
  actividadId     String?  @unique @map("mod_act_id") @db.Uuid // Vínculo con la actividad generada
  fecha           DateTime @map("mod_asi_fecha") @db.Date
  createdAt       DateTime @default(now()) @map("created_at")
  turnoId         String?  @map("pdt_id") @db.Uuid
  esPresencial    Boolean  @default(true) @map("mod_asi_presencial")

  modulo        ProgramaModuloDos?   @relation(fields: [moduloId], references: [id])
  moduloMaestro ProgramaModulo?      @relation(fields: [moduloMaestroId], references: [id])
  actividad     mod_actividad?       @relation(fields: [actividadId], references: [id])
  registros     mod_asistencia_reg[]

  @@map("mod_asistencia")
}

/// Estado de asistencia de un participante/facilitador en una sesión.
model mod_asistencia_reg {
  id           String  @id @default(uuid()) @db.Uuid
  asistenciaId String  @map("mod_asi_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  estado       String  @default("P") @map("mod_asi_reg_estado")
  // P = Presente, F = Falta, L = Licencia, TP = Tardanza Presente
  observacion  String? @map("mod_asi_reg_obs")

  asistencia mod_asistencia @relation(fields: [asistenciaId], references: [id])
  user       User           @relation(fields: [userId], references: [id])

  @@map("mod_asistencia_reg")
}

// ---------------------------------------------------------
// 9. CALIFICACIONES — PROCESO Y RESULTADO FINAL
// ---------------------------------------------------------

/// Nota de un alumno en una actividad concreta (foro, tarea o cuestionario).
/// Si esCalificable=false, esta nota NO entra en el registro académico oficial.
model mod_nota_actividad {
  id            String    @id @default(uuid()) @db.Uuid
  actividadId   String    @map("mod_act_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  nota          Float     @map("mod_na_nota")
  entroRegistro Boolean   @default(true) @map("mod_na_entro_registro")
  // false si la actividad es FORMULARIO (diagnóstico)
  observacion   String?   @map("mod_na_obs")
  fechaCalif    DateTime? @map("mod_na_fecha_calif")
  facilitadorId String?   @map("facilitador_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  actividad   mod_actividad @relation(fields: [actividadId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  facilitador User?         @relation("FacilitadorNotas", fields: [facilitadorId], references: [id])

  @@unique([actividadId, userId])
  @@map("mod_nota_actividad")
}

/// Nota final PONDERADA de un alumno en un módulo.
/// El sistema calcula: suma(notas_actividaes_por_categoria * peso_categoria / 100).
/// Este registro es el que aparece en el Acta y el PDF oficial.
model mod_nota_final {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  moduloId        String?  @map("pm_id") @db.Uuid
  moduloMaestroId String?  @map("pm_id_maestro") @db.Uuid
  notaAcademica   Float    @default(0) @map("mod_nf_academica") // Ej: 76.5 / 80
  notaFinal       Float    @default(0) @map("mod_nf_final") // Ej: 18.0 / 20
  notaTotal       Float    @default(0) @map("mod_nf_total") // Ej: 94.5 / 100
  estadoCalif     String   @default("pendiente") @map("mod_nf_estado")
  // pendiente, aprobado, reprobado
  asistenciaPct   Float?   @map("mod_nf_asist_pct") // % de asistencia
  generadoEn      DateTime @default(now()) @map("mod_nf_generado_en")

  user          User               @relation(fields: [userId], references: [id])
  modulo        ProgramaModuloDos? @relation(fields: [moduloId], references: [id])
  moduloMaestro ProgramaModulo?    @relation(fields: [moduloMaestroId], references: [id])

  @@unique([userId, moduloId])
  @@map("mod_nota_final")
}

// ---------------------------------------------------------
// 10. GAMIFICACIÓN — INSIGNIAS Y LOGROS (Bonus: mejor que Moodle)
// ---------------------------------------------------------

/// Insignia / Badge que el sistema otorga automáticamente por logros.
model mod_insignia {
  id          String   @id @default(uuid()) @db.Uuid
  nombre      String   @map("mod_ins_nombre")
  descripcion String   @map("mod_ins_desc")
  icono       String   @map("mod_ins_icono") // URL o emoji
  color       String   @default("#6366f1") @map("mod_ins_color")
  tipo        String   @map("mod_ins_tipo")
  // ASISTENCIA_PERFECTA, PRIMER_FORO, TAREA_100, PRIMER_PUESTO, etc.
  createdAt   DateTime @default(now()) @map("created_at")

  otorgadas mod_insignia_user[]

  @@map("mod_insignia")
}

model mod_insignia_user {
  id         String   @id @default(uuid()) @db.Uuid
  insigniaId String   @map("mod_ins_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  otorgadoEn DateTime @default(now()) @map("mod_ins_user_en")

  insignia mod_insignia @relation(fields: [insigniaId], references: [id])
  user     User         @relation(fields: [userId], references: [id])

  @@unique([insigniaId, userId])
  @@map("mod_insignia_user")
}

// ---------------------------------------------------------
// 11. NOTIFICACIONES INTERNAS DEL LMS
// ---------------------------------------------------------

model mod_notificacion {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  titulo    String   @map("mod_noti_titulo")
  mensaje   String   @map("mod_noti_mensaje") @db.Text
  leida     Boolean  @default(false) @map("mod_noti_leida")
  tipo      String   @map("mod_noti_tipo")
  // NUEVA_ACTIVIDAD, ENTREGA_CALIFICADA, NUEVO_POST, INSIGNIA, RECORDATORIO
  linkRef   String?  @map("mod_noti_link")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("mod_notificacion")
}

// ---------------------------------------------------------
// 12. CAMPOS EXTRA DINÁMICOS PARA PERFIL Y MÓDULOS
//     Basado en la lógica de evento_campo_extra
// ---------------------------------------------------------

model mod_campo_extra {
  id            String            @id @default(uuid()) @db.Uuid
  label         String            @map("mod_ce_label")
  tipo          ModTipoCampoExtra @map("mod_ce_tipo")
  opciones      Json?             @map("mod_ce_opciones") // JSON para listas de selección
  esObligatorio Boolean           @default(false) @map("mod_ce_obligatorio")
  orden         Int               @default(0) @map("mod_ce_orden")
  estado        Estado            @default(activo) @map("mod_ce_estado")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  respuestas mod_campo_extra_respuesta[]

  @@map("mod_campo_extra")
}

model mod_campo_extra_respuesta {
  id           String   @id @default(uuid()) @db.Uuid
  campoExtraId String   @map("mod_ce_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  valor        String   @map("mod_cer_valor") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  campoExtra mod_campo_extra @relation(fields: [campoExtraId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@unique([campoExtraId, userId])
  @@map("mod_campo_extra_respuesta")
}

enum ModTipoCampoExtra {
  TEXTO
  BOOLEAN
  MULTIPLE_SELECT
  SINGLE_SELECT
}

// --- SISTEMA DE CORRESPONDENCIA ---

enum CorTipoDocumento {
  INFORME
  NOTA_INTERNA
  MEMORANDUM
  INSTRUCTIVO
}

model CorDocumento {
  id          String           @id @default(uuid()) @db.Uuid
  tipo        CorTipoDocumento
  cite        String           @unique @map("cor_cite")
  hr          String?          @map("cor_hr")
  correlativo Int              @map("cor_correlativo")
  gestion     Int              @map("cor_gestion")
  referencia  String           @map("cor_referencia") @db.Text
  contenido   String?          @map("cor_contenido") @db.Text
  archivoPdf  String?          @map("cor_archivo_pdf")
  estado      String           @default("ELABORACION") @map("cor_estado")
  tenantId    String?          @map("tenant_id") @db.Uuid

  // Relaciones
  participantes CorParticipante[]
  seguimientos  CorSeguimiento[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([cite])
  @@index([gestion, correlativo])
  @@map("cor_documentos")
}

model CorParticipante {
  id           String  @id @default(uuid()) @db.Uuid
  documentoId  String  @map("doc_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  rol          String  @map("par_rol") // DESTINATARIO, VIA, REMITENTE
  cargoLiteral String? @map("par_cargo_literal") @db.Text

  documento CorDocumento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  usuario   User         @relation(fields: [userId], references: [id])

  @@index([userId, rol])
  @@map("cor_participantes")
}

model CorSeguimiento {
  id             String   @id @default(uuid()) @db.Uuid
  documentoId    String   @map("doc_id") @db.Uuid
  fecha          DateTime @default(now()) @map("seg_fecha")
  accion         String   @map("seg_accion") // CREACION, ENVIO, RECEPCION, DERIVACION, OBSERVACION, CANCELAR, DEVOLUCION
  detalle        String?  @map("seg_detalle") @db.Text
  usuarioId      String   @map("user_id") @db.Uuid
  archivoUrl     String?  @map("seg_archivo_url")
  destinatarioId String?  @map("seg_destinatario_id") @db.Uuid // A quién se envía/deriva

  documento    CorDocumento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  usuario      User         @relation(fields: [usuarioId], references: [id])
  destinatario User?        @relation("CorSeguimientoDestinatario", fields: [destinatarioId], references: [id])

  @@index([documentoId])
  @@map("cor_seguimientos")
}
