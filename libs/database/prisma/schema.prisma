  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedBy           String?   @map("deleted_by") @db.Uuid

  // Relaciones
  programa          ProgramaDos                 @relation(fields: [programaId], references: [id])
  turno             ProgramaDosTurno?           @relation(fields: [turnoId], references: [id])
  sede              Sede                        @relation("InscripcionesSede", fields: [sedeId], references: [id])
  estadoInscripcion programa_inscripcion_estado @relation(fields: [estadoInscripcionId], references: [id])
  persona           User                        @relation("InscripcionesUser", fields: [personaId], references: [id])
